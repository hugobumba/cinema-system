@startuml

enum USER_ROLE {
    ADMIN
    CUSTOMER
}

enum RESERVATION_STATUS {
    PENDING
    CONFIRMED
    CANCELLED
}

enum SEAT_ROW {
    A
    B
    C
    D
    E
    F
}

enum MOVIE_GENRE {
    ACTION
    COMEDY
    DRAMA
    HORROR
    THRILLER
    ROMANCE
    ANIMATION
}

enum AGE_RATING {
    ALL
    AGE_6
    AGE_12
    AGE_16
    AGE_18
}



entity USER {
    id : Long <<PK>>
    name : string
    email : string <<UNIQUE>>
    password : string
    role : USER_ROLE
}

entity CINEMA {
    id : Long <<PK>>
    name : string
    location : string
}

entity ROOM {
    id : Long <<PK>>
    cinema_id : Long <<FK>>
    number : string
}

entity SEAT {
    id : Long <<PK>>
    room_id : Long <<FK>>
    seat_row : SEAT_ROW
    seat_number : string
}

entity MOVIE {
    id : Long <<PK>>
    title : string
    description : longtext
    poster_url : string
    genre : MOVIE_GENRE
    duration_in_minutes : int
    age_rating : AGE_RATING
}

entity SHOWTIME {
    id : Long <<PK>>
    room_id : Long <<FK>>
    movie_id : Long <<FK>>
    start_time : datetime
    price : decimal
}

entity RESERVATION {
    id : Long <<PK>>
    user_id : Long <<FK>>
    showtime_id : Long <<FK>>
    status : RESERVATION_STATUS
    total_price : decimal
    created_at : datetime
    updated_at : datetime
}

entity RESERVATION_SEAT {
    reservation_id : Long <<FK>>
    seat_id : Long <<FK>>
    showtime_id : Long <<FK>>
}



USER --{ RESERVATION : makes
CINEMA --{ ROOM : has
ROOM --{ SEAT : has
ROOM --{ SHOWTIME : hosts
MOVIE --{ SHOWTIME : shows_in
SHOWTIME --{ RESERVATION : receives
RESERVATION --{ RESERVATION_SEAT : includes
SEAT --{ RESERVATION_SEAT : reserved_as
SHOWTIME --{ RESERVATION_SEAT : locks

@enduml
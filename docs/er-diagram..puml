
@startuml

object USER {
    id : Long
    name
    email
    password_hash
    role
}

object CINEMA {
    id : Long
    name
    location
}

object ROOM {
    id : Long
    cinema_id : Long
    number
}

object SEAT {
    id : Long
    room_id : Long
    seat_row
    seat_number
}

object MOVIE {
    id : Long
    title
    description
    poster_url
    genre
    duration_minutes
    age_rating
}

object SHOWTIME {
    id : Long
    room_id : Long
    movie_id : Long
    start_time
    price
}

object RESERVATION {
    id : Long
    user_id : Long
    showtime_id : Long
    status
    total_price
    created_at
    updated_at
}

object RESERVATION_SEAT {
    reservation_id : Long
    seat_id : Long
    showtime_id : Long
}

USER --{ RESERVATION : makes
CINEMA --{ ROOM : has
ROOM --{ SEAT : has
ROOM --{ SHOWTIME : hosts
MOVIE --{ SHOWTIME : shows_in
SHOWTIME --{ RESERVATION : receives
RESERVATION --{ RESERVATION_SEAT : includes
SEAT --{ RESERVATION_SEAT : reserved_as
SHOWTIME --{ RESERVATION_SEAT : locks

@enduml


@startuml

object USER {
    id
    name
    email
    password_hash
    role
}

object CINEMA {
    id
    name
    location
}

object ROOM {
    id
    cinema_id
    number
}

object SEAT {
    id
    room_id
    seat_row
    seat_number
}

object MOVIE {
    id
    title
    description
    poster_url
    genre
    duration_minutes
    age_rating
}

object SHOWTIME {
    id
    room_id
    movie_id
    start_time
    price
}

object RESERVATION {
    id
    user_id
    showtime_id
    status
    total_price
    created_at
}

object RESERVATION_SEAT {
    reservation_id
    seat_id
    showtime_id
}

USER --{ RESERVATION : makes
CINEMA --{ ROOM : has
ROOM --{ SEAT : has
ROOM --{ SHOWTIME : hosts
MOVIE --{ SHOWTIME : shows_in
SHOWTIME --{ RESERVATION : receives
RESERVATION --{ RESERVATION_SEAT : includes
SEAT --{ RESERVATION_SEAT : reserved_as
SHOWTIME --{ RESERVATION_SEAT : locks

@enduml
